         profiler.push("tick");
         this.tickFrame.start();
+        io.papermc.paper.shelfback.ShelfbackHook.INSTANCE.tickStart(this);
         // Paper - improve tick loop - moved into runAllTasksAtTickStart
         this.runAllTasksAtTickStart(); // Paper - improve tick loop
         this.tickServer(sprinting ? () -> false : this::haveTime);
@@ -1667,6 +1668,7 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
